---
interface Props {
  value: string;
  unit: string;
  description: string;
  color?: 'primary' | 'accent';
}

const { value, unit, description, color = 'primary' } = Astro.props;

const colorClasses = {
  primary: 'text-primary-600',
  accent: 'text-accent-600',
};
---

<div class="text-center p-8">
  <div class="mb-4">
    <span class={`font-display font-bold text-6xl lg:text-7xl ${colorClasses[color]}`}>
      {value}
    </span>
    <span class={`font-display font-bold text-2xl lg:text-3xl ${colorClasses[color]} ml-2`}>
      {unit}
    </span>
  </div>
  <p class="text-secondary-600 text-lg leading-relaxed max-w-xs mx-auto">
    {description}
  </p>
</div>
