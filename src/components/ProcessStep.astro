---
interface Props {
  number: number;
  title: string;
  description: string;
  image: string;
}

const { number, title, description, image } = Astro.props;
---

<div class="relative">
  <!-- Step number -->
  <div class="absolute -top-4 -left-4 w-12 h-12 bg-primary-600 text-white rounded-full flex items-center justify-center font-display font-bold text-xl shadow-lg z-10">
    {number}
  </div>

  <!-- Card -->
  <div class="card overflow-hidden">
    <div class="aspect-[4/3] overflow-hidden">
      <img
        src={image}
        alt={`Etape ${number}: ${title} - Les Precieuses`}
        width="400"
        height="300"
        class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="p-6">
      <h3 class="font-display font-bold text-xl text-secondary-800 mb-2">
        {title}
      </h3>
      <p class="text-secondary-600 leading-relaxed">
        {description}
      </p>
    </div>
  </div>
</div>
