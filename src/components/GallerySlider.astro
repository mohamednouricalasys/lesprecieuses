---
/**
 * Galerie : carrousel minute de photographies 4:5 avec legendes
 * (inspire de la galerie de nousavonsdeselles.vercel.app).
 *
 * - 1 photo (mobile) / 2 (tablette) / 3 (desktop) par vue.
 * - La barre de progression EST le minuteur : a la fin de son animation, on avance.
 * - Pause au survol, au focus clavier, pendant un glisser, hors ecran et onglet masque ;
 *   le bouton pause l'arrete durablement. prefers-reduced-motion : demarre a l'arret.
 * - Glisser (souris / doigt), fleches clavier, boutons precedent / suivant.
 * - Sans JavaScript : defilement horizontal natif, barre de controle masquee.
 */
import media from '../data/media.json';
import { useTranslations, type Language } from '../i18n';

interface Props {
  lang?: Language;
  /** Duree d'affichage d'une vue, en ms */
  interval?: number;
}

const { lang = 'fr', interval = 2560 } = Astro.props;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (file: string) => `${base}/images/${file}`;
const slides = media.gallery;
const pad = (n: number) => String(n).padStart(2, '0');
---

<section id="galerie" class="gallery py-20 lg:py-28" aria-labelledby="galerie-title">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <header class="max-w-3xl mb-10 lg:mb-12 reveal">
      <span class="eyebrow mb-4">{t.gallerySection.eyebrow}</span>
      <h2 id="galerie-title" class="gallery-title">{t.gallerySection.title}</h2>
    </header>

    <div
      class="gallery-slider"
      data-gallery
      role="region"
      aria-roledescription={t.gallerySection.roledescription}
      aria-label={t.gallerySection.label}
      data-interval={interval}
      data-label-pause={t.gallerySection.pause}
      data-label-play={t.gallerySection.play}
      style={`--interval: ${interval}ms`}
    >
      <div class="gallery-viewport">
        <ul class="gallery-track" data-track role="list">
          {slides.map((slide, i) => (
            <li class="gallery-slide" aria-label={`${pad(i + 1)} / ${pad(slides.length)}`}>
              <figure>
                <img
                  src={url(slide.src)}
                  srcset={slide.srcset.map(url).join(', ')}
                  sizes="(min-width: 1280px) 400px, (min-width: 1024px) 30vw, (min-width: 640px) 46vw, 86vw"
                  alt={slide.alt}
                  width={slide.width}
                  height={slide.height}
                  loading="lazy"
                  decoding="async"
                  draggable="false"
                />
                <figcaption class:list={['gallery-tag', i % 2 ? 'gallery-tag-warm' : 'gallery-tag-sage']}>
                  {slide.tag}
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>

      <div class="gallery-bar">
        <p class="gallery-counter" aria-hidden="true">
          <span data-current>01</span>
          <span class="gallery-counter-sep">/</span>
          <span>{pad(slides.length)}</span>
        </p>
        <div class="gallery-timer" aria-hidden="true"><span class="gallery-timer-fill" data-timer></span></div>
        <div class="gallery-controls">
          <button type="button" class="gallery-ctrl" data-prev aria-label={t.gallerySection.prev}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
          </button>
          <button type="button" class="gallery-ctrl gallery-toggle" data-toggle aria-pressed="false" aria-label={t.gallerySection.pause}>
            <svg class="gallery-ring" viewBox="0 0 36 36" aria-hidden="true"><circle cx="18" cy="18" r="16" pathLength="100" /></svg>
            <svg class="icon-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="7" y="5" width="3.5" height="14" rx="1" /><rect x="13.5" y="5" width="3.5" height="14" rx="1" /></svg>
            <svg class="icon-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13l11-6.5z" /></svg>
          </button>
          <button type="button" class="gallery-ctrl" data-next aria-label={t.gallerySection.next}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .gallery {
    /* Teinte sauge tres claire, comme la galerie de l'association */
    background-color: theme('colors.primary.50');
    --space: clamp(0.75rem, 0.5rem + 1vw, 1.25rem);
  }

  .gallery-title {
    font-family: theme('fontFamily.display');
    font-size: clamp(1.375rem, 1.1rem + 1vw, 2rem);
    font-style: italic;
    font-weight: 400;
    line-height: 1.35;
    color: theme('colors.secondary.800');
    text-wrap: balance;
  }

  .gallery-viewport {
    overflow: hidden;
    border-radius: 20px;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
    /* L'ombre et le leger soulevement au survol ne doivent pas etre rognes */
    padding-block: 6px 14px;
    margin-block: -6px -14px;
  }

  .gallery-track {
    display: flex;
    gap: var(--space);
    margin: 0;
    padding: 0;
    list-style: none;
    /* Depart doux, atterrissage long : la rangee glisse au lieu de sauter */
    transition: transform 600ms cubic-bezier(0.3, 0, 0.15, 1);
    will-change: transform;
  }

  .gallery-slider.is-dragging .gallery-track {
    transition: none;
  }

  .gallery-slide {
    flex: 0 0 86%;
    cursor: grab;
  }

  @media (min-width: 640px) {
    .gallery-slide { flex-basis: calc((100% - var(--space)) / 2); }
  }

  @media (min-width: 1024px) {
    .gallery-slide { flex-basis: calc((100% - 2 * var(--space)) / 3); }
  }

  .gallery-slider.is-dragging .gallery-slide {
    cursor: grabbing;
  }

  .gallery-slide figure {
    position: relative;
    margin: 0;
    aspect-ratio: 4 / 5;
    border-radius: 20px;
    overflow: hidden;
    background-color: theme('colors.primary.100');
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.18);
    transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.3s ease;
  }

  .gallery-slide:hover figure {
    transform: translateY(-4px);
    box-shadow: 0 10px 24px rgba(61, 43, 31, 0.22);
  }

  .gallery-slide img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform-origin: 50% 45%;
    pointer-events: none;
  }

  /* Les photos "respirent" (zoom tres lent), en vue ou non, pour ne jamais sauter */
  .gallery-slider.is-ready .gallery-slide img {
    animation: gallery-breathe calc(var(--interval) * 2) ease-in-out infinite alternate;
  }

  .gallery-slider.is-paused .gallery-slide img {
    animation-play-state: paused;
  }

  @keyframes gallery-breathe {
    from { transform: scale(1); }
    to { transform: scale(1.04); }
  }

  /* Legendes en pastille */
  .gallery-tag {
    position: absolute;
    left: var(--space);
    bottom: var(--space);
    max-width: calc(100% - 2 * var(--space));
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0.25rem 1rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1.25;
    box-shadow: 0 10px 20px -10px rgba(37, 33, 23, 0.7);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }

  .gallery-tag-sage {
    background-color: theme('colors.primary.600');
    color: #fff;
  }

  .gallery-tag-warm {
    background-color: theme('colors.warm.300');
    color: theme('colors.secondary.900');
  }

  .gallery-slider.is-ready .gallery-slide:not(.is-visible) .gallery-tag {
    opacity: 0;
    transform: translateY(12px);
  }

  .gallery-slide.is-visible .gallery-tag {
    transition-delay: 0.3s;
  }

  /* Barre : compteur, minuteur, controles */
  .gallery-bar {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 1.5rem;
    margin-top: 1.75rem;
  }

  .gallery-slider:not(.is-ready) .gallery-bar {
    display: none;
  }

  .gallery-counter {
    font-family: theme('fontFamily.display');
    font-size: 1.375rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: theme('colors.primary.800');
    white-space: nowrap;
  }

  .gallery-counter-sep {
    font-weight: 400;
    color: theme('colors.secondary.500');
  }

  .gallery-timer {
    position: relative;
    height: 4px;
    border-radius: 4px;
    background-color: rgba(39, 78, 57, 0.18);
    overflow: hidden;
  }

  .gallery-timer-fill {
    position: absolute;
    inset: 0;
    background-color: theme('colors.primary.600');
    transform: scaleX(0);
    transform-origin: left;
    animation: gallery-progress var(--interval) linear forwards;
  }

  @keyframes gallery-progress {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }

  .gallery-controls {
    display: flex;
    gap: 0.5rem;
  }

  .gallery-ctrl {
    position: relative;
    width: 2.75rem;
    height: 2.75rem;
    display: grid;
    place-items: center;
    border-radius: 9999px;
    border: 1px solid rgba(61, 43, 31, 0.25);
    background-color: theme('colors.cream');
    color: theme('colors.secondary.800');
    transition: background-color 0.2s ease, transform 0.1s ease;
  }

  .gallery-ctrl:hover {
    background-color: theme('colors.primary.100');
  }

  .gallery-ctrl:active {
    transform: scale(0.96);
  }

  .gallery-ctrl:focus-visible,
  .gallery-slider:focus-visible {
    outline: 2px solid theme('colors.primary.600');
    outline-offset: 3px;
  }

  .gallery-ctrl > svg:not(.gallery-ring) {
    width: 1.1rem;
    height: 1.1rem;
  }

  /* Anneau de compte a rebours autour du bouton pause */
  .gallery-ring {
    position: absolute;
    inset: -1px;
    width: calc(100% + 2px);
    height: calc(100% + 2px);
    transform: rotate(-90deg);
    pointer-events: none;
  }

  .gallery-ring circle {
    fill: none;
    stroke: theme('colors.primary.600');
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    animation: gallery-ring var(--interval) linear forwards;
  }

  @keyframes gallery-ring {
    to { stroke-dashoffset: 0; }
  }

  .gallery-slider.is-paused .gallery-timer-fill,
  .gallery-slider.is-paused .gallery-ring circle {
    animation-play-state: paused;
  }

  .gallery-toggle .icon-play,
  .gallery-slider.is-stopped .gallery-toggle .icon-pause {
    display: none;
  }

  .gallery-slider.is-stopped .gallery-toggle .icon-play {
    display: block;
  }

  /* Sans JavaScript : defilement horizontal natif */
  .gallery-slider:not(.is-ready) .gallery-viewport {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
  }

  .gallery-slider:not(.is-ready) .gallery-slide {
    scroll-snap-align: start;
  }

  @media (max-width: 639px) {
    .gallery-bar {
      grid-template-columns: auto minmax(0, 1fr);
      gap: 1rem 1.5rem;
    }

    .gallery-controls {
      justify-self: end;
    }

    .gallery-timer {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery-slider.is-ready .gallery-slide img {
      animation: none;
    }

    .gallery-track,
    .gallery-slide figure {
      transition: none;
    }

    /* La regle globale "reduced motion" ramene les animations a 0,01 ms :
       le minuteur doit garder sa vraie duree, sinon un clic sur lecture
       ferait defiler toutes les photos d'un coup. */
    .gallery-timer-fill,
    .gallery-ring circle {
      animation-duration: var(--interval) !important;
    }
  }
</style>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const pad = (n: number) => String(n).padStart(2, '0');

  // Relance une animation CSS (HTML comme SVG) en forcant un reflow
  const restart = (el: Element | null) => {
    if (!(el instanceof HTMLElement || el instanceof SVGElement)) return;
    el.style.animation = 'none';
    el.getBoundingClientRect();
    el.style.animation = '';
  };

  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const viewport = track.parentElement!;
    const slides = Array.from(track.children) as HTMLElement[];
    const toggle = root.querySelector<HTMLButtonElement>('[data-toggle]');
    const timer = root.querySelector('[data-timer]');
    const ring = root.querySelector('.gallery-ring circle');
    const current = root.querySelector('[data-current]');

    let index = 0;
    let stopped = reduceMotion;
    let near = false; // galerie proche de l'ecran : on peut precharger
    const holds = new Set<string>();

    const gap = () => parseFloat(getComputedStyle(track).columnGap) || 0;
    const perView = () => {
      const w = slides[0]?.getBoundingClientRect().width || 1;
      return Math.max(1, Math.round((viewport.clientWidth + gap()) / (w + gap())));
    };
    const maxIndex = () => Math.max(0, slides.length - perView());
    const offset = () => Math.min(slides[index]?.offsetLeft ?? 0, Math.max(0, track.scrollWidth - viewport.clientWidth));
    const place = (dx = 0) => {
      track.style.transform = `translateX(${-offset() + dx}px)`;
    };

    const syncPause = () => {
      root.classList.toggle('is-paused', stopped || holds.size > 0);
      root.classList.toggle('is-stopped', stopped);
      if (toggle) {
        toggle.setAttribute('aria-pressed', String(stopped));
        toggle.setAttribute('aria-label', (stopped ? root.dataset.labelPlay : root.dataset.labelPause) ?? '');
      }
    };
    const hold = (key: string, on: boolean) => {
      if (on) holds.add(key);
      else holds.delete(key);
      syncPause();
    };

    // Le viewport rogne les photos hors vue : le lazy loading natif ne les
    // chargerait qu'au dernier moment. Une fois la galerie proche de l'ecran
    // (et pas avant, pour ne pas concurrencer le Hero), on precharge la vue suivante.
    const preload = () => {
      if (!near) return;
      const pv = perView();
      slides.forEach((slide, n) => {
        const img = slide.querySelector('img');
        if (img && img.loading === 'lazy' && n >= index - 1 && n < index + pv * 2) img.loading = 'eager';
      });
    };

    const goTo = (i: number) => {
      const max = maxIndex();
      index = i > max ? 0 : i < 0 ? max : i;
      place();
      const pv = perView();
      slides.forEach((slide, n) => {
        const visible = n >= index && n < index + pv;
        slide.classList.toggle('is-visible', visible);
        slide.setAttribute('aria-hidden', String(!visible));
      });
      preload();
      const last = Math.min(index + pv, slides.length);
      if (current) current.textContent = last - index > 1 ? `${pad(index + 1)}–${pad(last)}` : pad(index + 1);
      restart(timer);
      restart(ring);
    };

    root.addEventListener('animationend', (e) => {
      if (e.animationName.includes('gallery-progress') && !stopped && holds.size === 0) goTo(index + 1);
    });
    root.querySelector('[data-prev]')?.addEventListener('click', () => goTo(index - 1));
    root.querySelector('[data-next]')?.addEventListener('click', () => goTo(index + 1));
    toggle?.addEventListener('click', () => {
      stopped = !stopped;
      syncPause();
    });

    root.addEventListener('mouseenter', () => hold('hover', true));
    root.addEventListener('mouseleave', () => hold('hover', false));
    root.addEventListener('focusin', () => hold('focus', true));
    root.addEventListener('focusout', (e) => {
      if (!root.contains(e.relatedTarget as Node)) hold('focus', false);
    });
    document.addEventListener('visibilitychange', () => hold('hidden', document.hidden));
    new IntersectionObserver(([entry]) => hold('offscreen', !entry.isIntersecting), { threshold: 0.25 }).observe(root);
    const nearObserver = new IntersectionObserver(([entry]) => {
      if (!entry.isIntersecting) return;
      near = true;
      preload();
      nearObserver.disconnect();
    }, { rootMargin: '800px 0px' });
    nearObserver.observe(root);

    // Clavier
    root.tabIndex = 0;
    root.addEventListener('keydown', (e) => {
      if (e.target !== root) return;
      if (e.key === 'ArrowLeft') { e.preventDefault(); goTo(index - 1); }
      if (e.key === 'ArrowRight') { e.preventDefault(); goTo(index + 1); }
    });

    // Glisser (souris / tactile) ; un geste vertical laisse la page defiler
    let startX = 0, startY = 0, dx = 0, dragging = false, decided = false, horizontal = false;
    root.addEventListener('pointerdown', (e) => {
      if (e.button !== 0 || (e.target as Element).closest('button, a')) return;
      dragging = true; decided = false; horizontal = false; dx = 0;
      startX = e.clientX; startY = e.clientY;
    });
    root.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const mx = e.clientX - startX, my = e.clientY - startY;
      if (!decided && (Math.abs(mx) > 6 || Math.abs(my) > 6)) {
        decided = true;
        horizontal = Math.abs(mx) > Math.abs(my);
        if (!horizontal) { dragging = false; return; }
        root.setPointerCapture(e.pointerId);
        root.classList.add('is-dragging');
        hold('drag', true);
      }
      if (!horizontal) return;
      dx = mx;
      if ((index === 0 && dx > 0) || (index === maxIndex() && dx < 0)) dx *= 0.35; // resistance aux bords
      place(dx);
    });
    const end = () => {
      if (!dragging) return;
      dragging = false;
      if (!horizontal) return;
      root.classList.remove('is-dragging');
      hold('drag', false);
      const threshold = Math.min(80, (slides[0]?.getBoundingClientRect().width ?? 300) * 0.18);
      goTo(dx < -threshold ? index + 1 : dx > threshold ? index - 1 : index);
    };
    root.addEventListener('pointerup', end);
    root.addEventListener('pointercancel', end);

    let resizeTimer: number | undefined;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => goTo(Math.min(index, maxIndex())), 120);
    });

    root.classList.add('is-ready');
    syncPause();
    goTo(0);
  });
</script>
