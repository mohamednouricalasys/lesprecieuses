---
import { useTranslations, type Language } from '../i18n';
import media from '../data/media.json';

interface Props {
  lang?: Language;
}

const { lang = 'fr' } = Astro.props;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (file: string) => `${base}/images/${file}`;
const heroSlides = media.hero;
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="hero relative flex items-center overflow-hidden bg-cream">
  <!-- Background decorations -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none" aria-hidden="true">
    <!-- Grid pattern -->
    <div class="absolute inset-0 bg-[linear-gradient(rgba(61,43,31,0.025)_1px,transparent_1px),linear-gradient(90deg,rgba(61,43,31,0.025)_1px,transparent_1px)] bg-[size:60px_60px]"></div>

    <!-- Gradient orbs, anchored to the content width so they frame it on wide screens -->
    <div class="absolute inset-y-0 left-1/2 -translate-x-1/2 w-full max-w-[100rem]">
      <div class="absolute top-1/4 -left-20 w-96 h-96 bg-primary-200/40 rounded-full blur-3xl animate-pulse-soft"></div>
      <div class="absolute bottom-1/4 -right-20 w-80 h-80 bg-warm-200/30 rounded-full blur-3xl animate-pulse-soft animate-delay-500"></div>
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-white/40 rounded-full blur-3xl"></div>
    </div>
  </div>

  <div class="hero-inner relative z-10 mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="hero-grid grid lg:grid-cols-2 items-center">
      <!-- Content -->
      <div class="text-center lg:text-left">
        <div class="eyebrow mb-6 animate-fade-in">
          <span>{t.hero.title}</span>
        </div>

        <h1 class="hero-title font-display font-bold animate-fade-in-up">
          <span class="hero-title-main block text-primary-600">{t.hero.titleLine1}</span>
          <span class="hero-title-sub block italic text-warm-500">{t.hero.titleLine2}</span>
        </h1>

        <p class="hero-lead text-secondary-800 max-w-xl mx-auto lg:mx-0 mb-10 animate-fade-in-up animate-delay-200">
          {t.hero.description}
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start animate-fade-in-up animate-delay-300">
          <a href="#contact" class="btn-primary group">
            {t.hero.primaryCta}
            <svg class="w-5 h-5 ml-2 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
            </svg>
          </a>
          <a href="#concept" class="btn-secondary">
            {t.hero.secondaryCta}
          </a>
        </div>
      </div>

      <!-- Hero photo carousel -->
      <div class="hero-visual animate-fade-in-up animate-delay-200">
        <div
          class="hero-carousel"
          data-hero-carousel
          data-interval="2560"
          role="region"
          aria-roledescription={t.gallerySection.roledescription}
          aria-label="Photographies des Précieuses"
          tabindex="0"
        >
          <!-- Segmented timer -->
          <div class="hero-progress" data-hero-segments role="group" aria-label="Navigation du diaporama">
            {heroSlides.map((_, i) => (
              <button type="button" class="hero-progress-seg" aria-label={`Aller à la diapositive ${i + 1}`}>
                <span class="hero-progress-fill"></span>
              </button>
            ))}
          </div>

          <ul class="hero-track" data-hero-track role="list">
            {heroSlides.map((slide, i) => (
              <li
                class:list={['hero-slide', i === 0 && 'is-active', i === 0 && 'is-visible']}
                role="group"
                aria-roledescription="diapositive"
                aria-label={`${i + 1} sur ${heroSlides.length}`}
                aria-hidden={i === 0 ? 'false' : 'true'}
              >
                <img
                  src={url(slide.src)}
                  srcset={slide.srcset.map((source) => `${url(source.split(' ')[0])} ${source.split(' ')[1]}`).join(', ')}
                  sizes="(min-width: 64rem) 32rem, 92vw"
                  alt={slide.alt}
                  width={slide.width}
                  height={slide.height}
                  fetchpriority={i === 0 ? 'high' : undefined}
                  loading={i === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                  draggable="false"
                />
                <div class="hero-slide-caption">
                  <a
                    class:list={['hero-slide-tag', i % 2 ? 'hero-slide-tag-warm' : 'hero-slide-tag-sage']}
                    href="#galerie"
                    tabindex={i === 0 ? '0' : '-1'}
                  >
                    {slide.tag}
                  </a>
                </div>
              </li>
            ))}
          </ul>

          <div class="hero-carousel-controls">
            <button type="button" class="hero-ctrl" data-hero-prev aria-label={t.gallerySection.prev}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
            </button>
            <button type="button" class="hero-ctrl hero-toggle" data-hero-toggle aria-pressed="false" aria-label={t.gallerySection.pause}>
              <svg class="hero-ring" viewBox="0 0 36 36" aria-hidden="true"><circle cx="18" cy="18" r="16" pathLength="100" /></svg>
              <svg class="icon-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="7" y="5" width="3.5" height="14" rx="1" /><rect x="13.5" y="5" width="3.5" height="14" rx="1" /></svg>
              <svg class="icon-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.5v13L19 12z" /></svg>
            </button>
            <button type="button" class="hero-ctrl" data-hero-next aria-label={t.gallerySection.next}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
            </button>
          </div>

          <p class="hero-carousel-counter" aria-live="polite">
            <span data-hero-current>{pad(1)}</span><span aria-hidden="true"> / {pad(heroSlides.length)}</span>
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="hero-scroll absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
    <a href="#concept" class="flex flex-col items-center gap-2 text-secondary-400 hover:text-primary-500 transition-colors">
      <span class="text-xs font-medium">{t.hero.scrollLabel}</span>
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
      </svg>
    </a>
  </div>
</section>

<style>
  /* ---------- Layout ---------- */
  .hero {
    /* Fills the viewport, but never stretches into a void on very tall screens */
    /* ...moins la hauteur du bandeau galerie qui le suit, pour qu'il soit visible
       des l'ouverture */
    min-height: clamp(34rem, calc(100vh - var(--marquee-block)), 60rem);
    min-height: clamp(34rem, calc(100svh - var(--marquee-block)), 60rem);
  }

  .hero-inner {
    /* Top padding clears the fixed header; both scale with viewport height */
    padding-top: clamp(7rem, 15vh, 10rem);
    padding-bottom: clamp(5.5rem, 11vh, 8rem);
  }

  .hero-grid {
    row-gap: clamp(3rem, 8vw, 4.5rem);
    column-gap: clamp(2rem, 4vw, 4.5rem);
  }

  @media (min-width: 1024px) {
    .hero-visual {
      width: min(100%, max(27rem, calc((100vh - 17rem) * 1.04)));
      width: min(100%, max(27rem, calc((100svh - 17rem) * 1.04)));
      margin-inline: auto 0;
    }
  }

  /* ---------- Carrousel ---------- */
  .hero-carousel {
    --interval: 2560ms;
    position: relative;
    width: 100%;
    max-width: 32rem;
    margin-inline: auto;
    aspect-ratio: 4 / 5;
    max-height: calc(100svh - 11rem);
    border-radius: 22px;
    overflow: hidden;
    background: theme('colors.primary.100');
    box-shadow: 0 18px 48px rgba(61, 43, 31, 0.18);
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }

  .hero-track {
    display: flex;
    height: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
    transition: transform 650ms cubic-bezier(0.25, 0.8, 0.25, 1);
    will-change: transform;
  }

  .hero-carousel.is-dragging .hero-track {
    transition: none;
  }

  .hero-slide {
    position: relative;
    flex: 0 0 100%;
    height: 100%;
    overflow: hidden;
    cursor: grab;
  }

  .hero-carousel.is-dragging .hero-slide {
    cursor: grabbing;
  }

  .hero-slide::after {
    content: '';
    position: absolute;
    inset: 55% 0 0;
    background: linear-gradient(transparent, rgba(34, 28, 23, 0.55));
    pointer-events: none;
  }

  .hero-slide img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform-origin: 50% 45%;
    pointer-events: none;
  }

  /* La photo active respire pendant que son minuteur tourne */
  .hero-slide.is-active img {
    animation: hero-breathe var(--interval) ease-in-out forwards;
  }

  .hero-carousel.is-paused .hero-slide.is-active img {
    animation-play-state: paused;
  }

  @keyframes hero-breathe {
    from { transform: scale(1); }
    to { transform: scale(1.045); }
  }

  .hero-slide-caption {
    position: absolute;
    z-index: 2;
    left: clamp(1rem, 3vw, 1.5rem);
    right: clamp(1rem, 3vw, 1.5rem);
    bottom: clamp(4.25rem, 9vw, 4.9rem);
  }

  .hero-carousel.is-ready .hero-slide-caption > * {
    opacity: 0;
    transform: translateY(12px);
  }

  .hero-carousel.is-ready .hero-slide.is-active .hero-slide-caption > * {
    opacity: 1;
    transform: none;
    transition: opacity 0.6s ease, transform 0.6s ease;
    transition-delay: 0.25s;
  }

  .hero-slide-tag {
    display: inline-flex;
    min-height: 2.35rem;
    align-items: center;
    padding: 0.4rem 1rem;
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 10px 20px -10px rgba(37, 33, 23, 0.7);
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .hero-slide-tag-sage {
    background: theme('colors.primary.600');
    color: #fff;
  }

  .hero-slide-tag-warm {
    background: theme('colors.warm.300');
    color: theme('colors.secondary.900');
  }

  .hero-slide-tag:hover {
    transform: translateY(-2px);
  }

  .hero-slide-tag-warm:hover {
    background: theme('colors.warm.400');
  }

  /* Barres de progression segmentees */
  .hero-progress {
    position: absolute;
    top: clamp(0.7rem, 2vw, 1rem);
    left: clamp(0.7rem, 2vw, 1rem);
    right: clamp(0.7rem, 2vw, 1rem);
    z-index: 3;
    display: flex;
    gap: 0.3rem;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: rgba(34, 28, 23, 0.28);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }

  .hero-progress-seg {
    flex: 1;
    display: flex;
    height: 1.25rem;
    align-items: center;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .hero-progress-fill {
    position: relative;
    display: block;
    width: 100%;
    height: 3px;
    overflow: hidden;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.42);
  }

  .hero-progress-fill::after {
    content: '';
    position: absolute;
    inset: 0;
    background: #fff;
    transform: scaleX(0);
    transform-origin: left;
  }

  .hero-progress-seg:hover .hero-progress-fill::after {
    background: theme('colors.warm.300');
  }

  .hero-progress-seg.is-done .hero-progress-fill::after {
    transform: scaleX(1);
  }

  .hero-progress-seg.is-active .hero-progress-fill::after {
    background: theme('colors.warm.300');
    animation: hero-progress-fill var(--interval) linear forwards;
  }

  .hero-carousel.is-paused .hero-progress-seg.is-active .hero-progress-fill::after {
    animation-play-state: paused;
  }

  @keyframes hero-progress-fill {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }

  /* Controles en verre fume, lisibles sur toutes les photos */
  .hero-carousel-controls {
    position: absolute;
    right: clamp(0.7rem, 2vw, 1rem);
    bottom: clamp(0.7rem, 2vw, 1rem);
    z-index: 3;
    display: flex;
    gap: 0.4rem;
  }

  .hero-ctrl {
    position: relative;
    display: grid;
    width: 2.6rem;
    height: 2.6rem;
    place-items: center;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.35);
    background: rgba(34, 28, 23, 0.42);
    color: #fff;
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    transition: background-color 0.18s ease, transform 0.1s ease;
  }

  .hero-ctrl:hover {
    background: rgba(34, 28, 23, 0.62);
  }

  .hero-ctrl:active {
    transform: scale(0.95);
  }

  .hero-ctrl > svg:not(.hero-ring) {
    width: 1.1rem;
    height: 1.1rem;
  }

  /* Anneau de compte a rebours autour du bouton pause */
  .hero-ring {
    position: absolute;
    inset: -1px;
    width: calc(100% + 2px);
    height: calc(100% + 2px);
    transform: rotate(-90deg);
    pointer-events: none;
  }

  .hero-ring circle {
    fill: none;
    stroke: theme('colors.warm.300');
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    animation: hero-ring var(--interval) linear forwards;
  }

  .hero-carousel.is-paused .hero-ring circle {
    animation-play-state: paused;
  }

  @keyframes hero-ring {
    to { stroke-dashoffset: 0; }
  }

  .hero-toggle .icon-play {
    display: none;
  }

  .hero-carousel.is-stopped .hero-toggle .icon-play {
    display: block;
  }

  .hero-carousel.is-stopped .hero-toggle .icon-pause {
    display: none;
  }

  .hero-carousel-counter {
    position: absolute;
    right: clamp(0.9rem, 2vw, 1.3rem);
    top: clamp(2.3rem, 4vw, 2.8rem);
    z-index: 3;
    margin: 0;
    color: #fff;
    font-family: theme('fontFamily.display');
    font-size: 0.95rem;
    font-variant-numeric: tabular-nums;
    text-shadow: 0 2px 8px rgba(20, 18, 14, 0.45);
  }

  .hero-carousel-counter span + span {
    color: rgba(255, 255, 255, 0.7);
    font-weight: 400;
  }

  .hero-carousel :is(button, a):focus-visible,
  .hero-carousel:focus-visible {
    outline: 2px solid theme('colors.primary.600');
    outline-offset: 3px;
  }

  @media (max-width: 639px) {
    .hero-grid { row-gap: 2.5rem; }
    .hero-carousel { border-radius: 18px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-track,
    .hero-slide img,
    .hero-slide-tag {
      transition: none !important;
    }

    .hero-slide.is-active img {
      animation: none;
    }

    .hero-carousel.is-ready .hero-slide-caption > * {
      transition: none;
    }

    /* Le minuteur doit garder sa vraie duree malgre la regle globale. */
    .hero-progress-seg.is-active .hero-progress-fill::after,
    .hero-ring circle {
      animation-duration: var(--interval) !important;
    }
  }

  /* ---------- Typographie ---------- */
  .hero-title {
    margin-bottom: clamp(1.5rem, 1rem + 1.5vw, 2rem);
    text-wrap: balance;
  }

  .hero-title-main {
    font-size: var(--fs-h1);
    line-height: var(--lh-tight);
  }

  .hero-title-sub {
    font-size: var(--fs-h1-sub);
    line-height: var(--lh-heading);
    margin-top: 0.35em;
  }

  .hero-lead {
    font-size: var(--fs-lead);
    line-height: 1.65;
  }

  @media (min-width: 1024px) {
    /* En deux colonnes, le titre suit la largeur de sa colonne (~43vw)
       plutot que celle de l'ecran : pas de debordement ni de coupure brutale. */
    .hero-title-main {
      font-size: clamp(2.5rem, 4.1vw, 3.375rem);
    }

    .hero-title-sub {
      font-size: clamp(2.125rem, 3.4vw, 2.75rem);
    }
  }

  /* Short landscape viewports (laptops): hide the scroll hint - the gallery band
     right below already invites to scroll - and tighten the bottom spacing so
     the band stays visible in the first view. */
  @media (max-height: 860px) and (min-width: 1024px) {
    .hero-scroll {
      display: none;
    }

    .hero-inner {
      padding-bottom: clamp(2rem, 5vh, 3rem);
    }

    .hero-carousel {
      max-height: calc(100svh - 9rem);
    }
  }
</style>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const restart = (el: Element | null) => {
    if (!(el instanceof HTMLElement || el instanceof SVGElement)) return;
    el.style.animation = 'none';
    el.getBoundingClientRect();
    el.style.animation = '';
  };

  document.querySelectorAll<HTMLElement>('[data-hero-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-hero-track]')!;
    const slides = Array.from(track.children) as HTMLElement[];
    const segs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-hero-segments] > button'));
    const toggle = root.querySelector<HTMLButtonElement>('[data-hero-toggle]');
    const ring = root.querySelector('.hero-ring circle');
    const current = root.querySelector<HTMLElement>('[data-hero-current]');
    const interval = Number(root.dataset.interval) || 2560;
    root.style.setProperty('--interval', `${interval}ms`);

    let index = 0;
    let stopped = reducedMotion;
    const holds = new Set<string>();

    const sync = () => {
      const paused = stopped || holds.size > 0;
      root.classList.toggle('is-paused', paused);
      root.classList.toggle('is-stopped', stopped);
      toggle?.setAttribute('aria-pressed', String(stopped));
      toggle?.setAttribute('aria-label', stopped ? 'Reprendre le diaporama' : 'Mettre le diaporama en pause');
    };

    const hold = (key: string, on: boolean) => {
      if (on) holds.add(key);
      else holds.delete(key);
      sync();
    };

    const goTo = (next: number) => {
      index = (next + slides.length) % slides.length;
      track.style.transform = `translateX(${-index * 100}%)`;
      slides.forEach((slide, i) => {
        const active = i === index;
        slide.classList.toggle('is-active', active);
        slide.classList.toggle('is-visible', active);
        slide.setAttribute('aria-hidden', String(!active));
        slide.querySelectorAll<HTMLElement>('a, button').forEach((el) => {
          el.tabIndex = active ? 0 : -1;
        });
        const img = slide.querySelector('img');
        if (img && img.loading === 'lazy' && (i === index || i === index + 1)) img.loading = 'eager';
      });
      segs.forEach((seg, i) => {
        seg.classList.toggle('is-active', i === index);
        seg.classList.toggle('is-done', i < index);
        if (i === index) seg.setAttribute('aria-current', 'true');
        else seg.removeAttribute('aria-current');
      });
      if (current) current.textContent = String(index + 1).padStart(2, '0');
      restart(segs[index]?.querySelector('.hero-progress-fill') ?? null);
      restart(ring);
    };

    segs.forEach((seg, i) => seg.addEventListener('click', () => goTo(i)));

    root.addEventListener('animationend', (event) => {
      const name = (event as AnimationEvent).animationName;
      if (name === 'hero-progress-fill' && !stopped && holds.size === 0) goTo(index + 1);
    });

    root.querySelector('[data-hero-prev]')?.addEventListener('click', () => goTo(index - 1));
    root.querySelector('[data-hero-next]')?.addEventListener('click', () => goTo(index + 1));
    toggle?.addEventListener('click', () => {
      stopped = !stopped;
      sync();
      restart(segs[index]?.querySelector('.hero-progress-fill') ?? null);
    });

    root.addEventListener('mouseenter', () => hold('hover', true));
    root.addEventListener('mouseleave', () => hold('hover', false));
    root.addEventListener('focusin', () => hold('focus', true));
    root.addEventListener('focusout', (event) => {
      if (!root.contains(event.relatedTarget as Node)) hold('focus', false);
    });
    document.addEventListener('visibilitychange', () => hold('hidden', document.hidden));
    new IntersectionObserver(([entry]) => hold('offscreen', !entry.isIntersecting), { threshold: 0.2 }).observe(root);

    root.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') { event.preventDefault(); goTo(index - 1); }
      if (event.key === 'ArrowRight') { event.preventDefault(); goTo(index + 1); }
    });

    /* Glisser (souris / tactile) ; un geste vertical laisse la page defiler */
    let startX = 0, startY = 0, dx = 0, dragging = false, decided = false, horizontal = false;
    root.addEventListener('pointerdown', (event) => {
      if (event.button !== 0 || (event.target as Element).closest('button, a')) return;
      dragging = true; decided = false; horizontal = false; dx = 0;
      startX = event.clientX; startY = event.clientY;
    });
    root.addEventListener('pointermove', (event) => {
      if (!dragging) return;
      const mx = event.clientX - startX, my = event.clientY - startY;
      if (!decided && (Math.abs(mx) > 6 || Math.abs(my) > 6)) {
        decided = true;
        horizontal = Math.abs(mx) > Math.abs(my);
        if (!horizontal) { dragging = false; return; }
        root.setPointerCapture(event.pointerId);
        root.classList.add('is-dragging');
        hold('drag', true);
      }
      if (!horizontal) return;
      dx = mx;
      track.style.transform = `translateX(calc(${-index * 100}% + ${dx}px))`;
    });
    const end = () => {
      if (!dragging) return;
      dragging = false;
      if (!horizontal) return;
      root.classList.remove('is-dragging');
      hold('drag', false);
      const threshold = Math.min(80, root.clientWidth * 0.18);
      goTo(dx < -threshold ? index + 1 : dx > threshold ? index - 1 : index);
    };
    root.addEventListener('pointerup', end);
    root.addEventListener('pointercancel', end);

    root.classList.add('is-ready');
    sync();
    goTo(0);
  });
</script>
